      "api": "rdk:component:arm",
      "model": "viam-labs:mujoco-sim:arm",
      "attributes": {
        "world": "sim-world",
        "max_joint_deg_s": 30,
        "max_joint_deg_s2": 60,
        "mjcf": "/Users/nick.hehr/viam-sim-demos/franka-mug/assets/franka_emika_panda/panda_nohand.xml"
      },
      "frame": {
        "parent": "world"
      }
    },
    {
      "name": "pick-gripper",
      "api": "rdk:component:gripper",
      "model": "viam-labs:mujoco-sim:gripper",
      "attributes": {
        "world": "sim-world",
        "arm": "pick-arm",
        "asset": "robotiq_2f85",
        "sensorless": true
      },
      "frame": {
        "parent": "pick-arm",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 155.8
        }
      }
    },
    {
      "name": "overview",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:camera",
      "attributes": {
        "world": "sim-world",
        "width": 1280,
        "height": 720,
        "target": [
          0.45,
          -0.15,
          0.05
        ]
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 1450,
          "y": 300,
          "z": 700
        }
      }
    },
    {
      "name": "top-depth",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:camera",
      "attributes": {
        "world": "sim-world",
        "fov_deg": 70,
        "width": 640,
        "height": 480,
        "depth": true,
        "depth_width": 320,
        "depth_height": 240
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 550,
          "y": 0,
          "z": 1300
        },
        "orientation": {
          "type": "ov_degrees",
          "value": {
            "x": 0,
            "y": 0,
            "z": -1,
