  "services": [
    {
      "name": "world-state",
      "api": "rdk:service:world_state_store",
      "model": "viam-labs:mujoco-sim:world_state",
      "attributes": {
        "world": "sim-world"
      }
    },
    {
      "name": "servo",
      "api": "rdk:service:motion",
      "model": "devrel:diff-ik:servo",
      "attributes": {
        "arms": [
          "pick-arm"
        ]
      }
    },
    {
      "name": "obstacles-top",
      "api": "rdk:service:vision",
      "model": "viam:obstacles-pointcloud:obstacles-pointcloud",
      "attributes": {
        "camera_name": "top-depth",
        "ground_plane_normal_vec": {
          "x": 0,
          "y": 0,
          "z": -1
        },
        "max_dist_from_plane_mm": 25,
        "min_points_in_plane": 2000,
        "min_points_in_segment": 50,
        "ground_angle_tolerance_degs": 10
      }
    },
    {
      "name": "obstacles-wrist",
      "api": "rdk:service:vision",
      "model": "viam:obstacles-pointcloud:obstacles-pointcloud",
      "attributes": {
        "camera_name": "wrist-depth",
        "ground_plane_normal_vec": {
          "x": 0,
          "y": 0,
          "z": -1
        },
        "max_dist_from_plane_mm": 10,
        "min_points_in_segment": 50
      }
    },
    {
      "name": "red",
      "api": "rdk:service:vision",
      "model": "color_detector",
      "attributes": {
        "detect_color": "#E60D0D",
        "hue_tolerance_pct": 0.06,
        "segment_size_px": 200
      }
    },
    {
      "name": "segments-top",
      "api": "rdk:service:vision",
      "model": "viam:vision:detections-to-segments",
      "attributes": {
        "camera_name": "top-depth",
        "detector_name": "red",
        "confidence_threshold_pct": 0.5,
        "mean_k": 5,
        "sigma": 1.25,
        "infer_minimum_depth": true
      }
    }
  ]
}