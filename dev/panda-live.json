          }
        }
      }
    },
    {
      "name": "wrist-depth",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:camera",
      "attributes": {
        "world": "sim-world",
        "fov_deg": 70,
        "width": 640,
        "height": 480,
        "depth": true,
        "depth_width": 320,
        "depth_height": 240
      },
      "frame": {
        "parent": "pick-arm",
        "translation": {
          "x": 0,
          "y": 70,
          "z": 40
        }
      }
